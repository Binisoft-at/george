# App settings for the shared CI scripts (scripts/ci, synced from the Binisoft handbook).
# This file belongs to the app; sync never touches it. Defaults are derived from APP_NAME.
APP_NAME=George

# Schemes and paths (defaults): IOS_SCHEME=George MAC_SCHEME=GeorgeMac WATCH_SCHEME=GeorgeWatch
# CORE_PACKAGE=Packages/GeorgeCore

# Targets this app has (1 = yes, 0 = no). No widgets yet.
HAS_MAC=1
HAS_WATCH=1
HAS_WIDGETS=0

# [screenshots] runs: screens opened with `-Demo -DemoScreen <name>` (see Router.applyLaunchOptions).
# "tour" opens the hands-on tour; "tour:<step>" opens it at a step.
SCREENSHOT_SCREENS="today workouts plans template live live-mid live-superset session muscles energy stats create settings welcome tour tour:match"
WATCH_SCREENS="home"
MAC_SCREENS="today muscles energy templates"
