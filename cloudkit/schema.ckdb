// George – CloudKit schema of iCloud.at.binisoft.george (SwiftData mirroring: CD_ prefix, one
// record type per @Model, to-one relationships as CD_<name> STRING, to-many sides are not stored,
// binary data as BYTES plus a CD_<name>_ckAsset ASSET for large values). HealthMetrics is device-only
// and never synced, so it isn't here.
//
// Keep it in step with App/Sources/Model/Models.swift. Order on every model change:
//   1. add the field here   2. Actions → CloudKit schema (imports into Development)
//   3. CloudKit Console → Deploy Schema Changes to Production   4. then the TestFlight build.
// Production only accepts additive changes: never rename or remove a field.

DEFINE SCHEMA

    RECORD TYPE CD_EnergyCheckIn (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        CD_date       TIMESTAMP,
        CD_entityName STRING,
        CD_id         STRING,
        CD_level      INT64,
        CD_note       STRING,
        CD_sessionID  STRING,
        CD_source     STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_ExcusedWeek (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        CD_createdAt  TIMESTAMP,
        CD_entityName STRING,
        CD_reason     STRING,
        CD_weekStart  TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Program (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        CD_colorHex   STRING,
        CD_createdAt  TIMESTAMP,
        CD_entityName STRING,
        CD_id         STRING,
        CD_isArchived INT64,
        CD_isPinned   INT64,
        CD_kindRaw    STRING,
        CD_name       STRING,
        CD_notes      STRING,
        CD_sortIndex  DOUBLE,
        CD_subtitle   STRING,
        CD_symbol     STRING,
        CD_updatedAt  TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_SyncedSettings (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        CD_activeProgramID         STRING,
        CD_askToUpdateTemplate     INT64,
        CD_autoUseSaves            INT64,
        CD_birthYear               INT64,
        CD_bodyMassKg              DOUBLE,
        CD_countHealthWorkouts     INT64,
        CD_createdAt               TIMESTAMP,
        CD_defaultRestSeconds      INT64,
        CD_entityName              STRING,
        CD_experienceRaw           STRING,
        CD_goalHistoryData         BYTES,
        CD_goalHistoryData_ckAsset ASSET,
        CD_goalRaw                 STRING,
        CD_minimumMinutes          INT64,
        CD_namingPattern           STRING,
        CD_prefillFromLastTime     INT64,
        CD_rescueCountsDouble      INT64,
        CD_rescueMinutes           INT64,
        CD_saveToHealth            INT64,
        CD_unitRaw                 STRING,
        CD_updatedAt               TIMESTAMP,
        CD_weeklyGoal              INT64,
        CD_weekStartsOn            INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_UserExercise (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        CD_createdAt    TIMESTAMP,
        CD_entityName   STRING,
        CD_equipment    STRING,
        CD_imageURL     STRING,
        CD_instructions STRING,
        CD_isCustom     INT64,
        CD_isFavorite   INT64,
        CD_key          STRING,
        CD_kindRaw      STRING,
        CD_linksRaw     STRING,
        CD_modeRaw      STRING,
        CD_musclesRaw   STRING,
        CD_name         STRING,
        CD_notes        STRING,
        CD_perSide      INT64,
        CD_updatedAt    TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_WorkoutSession (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        CD_accumulatedSeconds  DOUBLE,
        CD_colorHex            STRING,
        CD_contentData         BYTES,
        CD_contentData_ckAsset ASSET,
        CD_createdAt           TIMESTAMP,
        CD_doneSetCount        INT64,
        CD_effort              INT64,
        CD_endedAt             TIMESTAMP,
        CD_energyBefore        INT64,
        CD_energyKcal          DOUBLE,
        CD_entityName          STRING,
        CD_exerciseCount       INT64,
        CD_exerciseNames       STRING,
        CD_healthWorkoutID     STRING,
        CD_id                  STRING,
        CD_isFavorite          INT64,
        CD_isPinned            INT64,
        CD_isRescue            INT64,
        CD_kindRaw             STRING,
        CD_notes               STRING,
        CD_plannedDate         TIMESTAMP,
        CD_priorityRaw         INT64,
        CD_program             STRING,
        CD_recordedOnWatch     INT64,
        CD_resumedAt           TIMESTAMP,
        CD_setCount            INT64,
        CD_startedAt           TIMESTAMP,
        CD_statusRaw           STRING,
        CD_subtitle            STRING,
        CD_tagsRaw             STRING,
        CD_templateID          STRING,
        CD_templateName        STRING,
        CD_title               STRING,
        CD_updatedAt           TIMESTAMP,
        CD_volumeKg            DOUBLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_WorkoutTemplate (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        CD_colorHex            STRING,
        CD_contentData         BYTES,
        CD_contentData_ckAsset ASSET,
        CD_createdAt           TIMESTAMP,
        CD_entityName          STRING,
        CD_estimatedMinutes    INT64,
        CD_exerciseCount       INT64,
        CD_exerciseNames       STRING,
        CD_id                  STRING,
        CD_isFavorite          INT64,
        CD_isPinned            INT64,
        CD_kindRaw             STRING,
        CD_lastUsedAt          TIMESTAMP,
        CD_name                STRING,
        CD_notes               STRING,
        CD_priorityRaw         INT64,
        CD_program             STRING,
        CD_scheduleRaw         STRING,
        CD_setCount            INT64,
        CD_sortIndex           DOUBLE,
        CD_subtitle            STRING,
        CD_tagsRaw             STRING,
        CD_updatedAt           TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
